# Database Credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_this_to_secure_password
POSTGRES_EVENTHUB_DB=eventhub
POSTGRES_ANALYTICS_DB=analytics
POSTGRES_AUTH_DB=auth_db

# JWT Settings
JWT_SECRET=generate_your_own_128_character_hex_key
JWT_EXPIRATION=86400000

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Service Ports
EVENT_SERVICE_PORT=8081
ANALYTICS_SERVICE_PORT=8082
AUTH_SERVICE_PORT=8083
DASHBOARD_SERVICE_PORT=8084

# PostgreSQL Ports
POSTGRES_PORT=5432
POSTGRES_ANALYTICS_PORT=5433
POSTGRES_AUTH_PORT=5434