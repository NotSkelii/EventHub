### Get all Events (with filters)

GET {{baseUrl}}

### Get events by category
GET {{baseUrl}}?category=FESTIVAL

### Get events by city
GET {{baseUrl}}?city=New%20York

### Get events by category and city
GET {{baseUrl}}?category=THEATER&city=New%20York

### Get events with pagination
GET {{baseUrl}}?page=0&size=10&sort=eventDate,asc


### Get Event by id

GET {{baseUrl}}/40e8420a-3f1a-4f95-8005-75a55ca7af6a


### Update Event by id

PUT {{baseUrl}}/40e8420a-3f1a-4f95-8005-75a55ca7af6a
Content-Type: application/json
X-User-Id:{{userId}}

{
  "name": "Summer Music Festival - Updated",
  "description": "Even better 3-day music festival",
  "venue": "Central Park",
  "city": "New York",
  "category": "FESTIVAL",
  "eventDate": "2027-07-15T14:00:00",
  "totalSeats": 5500,
  "price": 169.99
}

### Reserve seats as userId

POST {{baseUrl}}/40e8420a-3f1a-4f95-8005-75a55ca7af6a/reserve?quantity=2
X-User-Id: {{userId}}

### Reserve seats as another user

POST {{baseUrl}}/40e8420a-3f1a-4f95-8005-75a55ca7af6a/reserve?quantity=5
X-User-Id: anotherUser

### Cancel seat reservations

POST {{baseUrl}}/40e8420a-3f1a-4f95-8005-75a55ca7af6a/cancel-reservation?quantity=2

### Delete Event

DELETE {{baseUrl}}/476595a5-cb39-44f0-ad7a-fb04d7da9b28
X-User-Id: {{userId}}

