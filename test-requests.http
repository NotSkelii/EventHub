### Variables
@baseUrl = http://localhost:8081/api/v1/events
@userId = user123

### Create event POST request

POST {{baseUrl}}
Content-Type: application/json
X-User-Id: {{userId}}

{
  "name": "Summer Music Festival",
  "description": "Amazing 3-day music festival with top artists",
  "venue": "Central Park",
  "city": "New York",
  "category": "FESTIVAL",
  "eventDate": "2027-07-15T14:00:00",
  "totalSeats": 5000,
  "price": 149.99
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 201, "Response status is not 201");
        client.global.set("eventId", response.body.id);
    });
%}

### Create concert event POST request

POST {{baseUrl}}
Content-Type: application/json
X-User-Id: {{userId}}

{
  "name": "Rock Concert 2024",
  "description": "Top rock bands live in concert",
  "venue": "Madison Square Garden",
  "city": "New York",
  "category": "CONCERT",
  "eventDate": "2027-06-15T20:00:00",
  "totalSeats": 2000,
  "price": 89.99
}

